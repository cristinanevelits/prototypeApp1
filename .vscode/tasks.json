{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "XIAO: Check board program",
      "type": "shell",
      "command": "arduino-cli",
      "args": [
        "compile",
        "--fqbn", "esp32:esp32:XIAO_ESP32C6",
        "--build-path", "${workspaceFolder}/.build/xiao",
        "${workspaceFolder}/firmware/MoodiWearable"
      ],
      "problemMatcher": []
    },
    {
      "label": "XIAO: Upload legacy firmware (disabled)",
      "type": "shell",
      "command": "sh",
      "args": [
        "${workspaceFolder}/scripts/upload-xiao.sh",
        "${input:xiaoPort}"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true }
    }
  ],
  "inputs": [
    {
      "id": "xiaoPort",
      "type": "promptString",
      "description": "XIAO USB port (check with: arduino-cli board list)",
      "default": "/dev/cu.usbmodem2101"
    }
  ]
}
